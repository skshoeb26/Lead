{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": { "MigrateOnStartup": true },
  "DataProtection": { "KeysPath": "/var/lib/leadpilot/keys" },
  "Jwt": {
    "Issuer": "leadpilot",
    "Audience": "leadpilot-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "AllowRegistration": false,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "capacitor://localhost", "https://localhost", "http://localhost", "http://localhost:4200" ]
  },
  "Swagger": { "Enabled": false },
  "Https": { "Redirect": false },
  "Jobs": { "Enabled": true, "RunServerInApi": false, "WorkerCount": 2 },
  "Providers": { "UseMocksWhenUnconfigured": false },
  "GooglePlaces": {
    "ApiKey": "",
    "CostPerRequestUsd": 0.035,
    "RequestsPerMinute": 60,
    "ContentRetentionDays": 30,
    "RefreshContentOnExpiry": false
  },
  "PageSpeed": { "Enabled": true, "ApiKey": "" },
  "WebsiteAnalysis": { "TimeoutSeconds": 15, "MaxExtraPages": 4, "MaxLinksToCheck": 10, "RespectRobotsTxt": true },
  "AI": {
    "Provider": "claude",
    "Claude": {
      "ApiKey": "",
      "Model": "claude-opus-5-5",
      "Effort": "medium",
      "MaxTokens": 8000,
      "EnableFallbacks": true
    }
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "AppReturnUrl": "leadpilot://settings/integrations"
  },
  "Email": { "TestMode": true },
  "Firebase": { "ProjectId": "", "ServiceAccountFile": "" },
  "WhatsApp": { "Enabled": false }
}
