# ============================================================================
# LeadPilot AI — production environment. Copy to .env and fill in.
# NEVER commit .env. Values here are placeholders only.
# ============================================================================

# ---- Domain / HTTPS
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com

# ---- Database
POSTGRES_DB=leadpilot
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=change-me-long-random-password
BACKUP_RETENTION_DAYS=14

# ---- ASP.NET
ASPNETCORE_ENVIRONMENT=Production
# At least 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__SigningKey=replace-with-openssl-rand-base64-48
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Swagger__Enabled=false
# Allowed origins for the app (Capacitor uses https://localhost on Android)
Cors__AllowedOrigins__0=https://localhost
Cors__AllowedOrigins__1=capacitor://localhost

# ---- Owner bootstrap (optional; otherwise register from the app on first launch, then registration closes)
Auth__BootstrapOwnerEmail=
Auth__BootstrapOwnerPassword=
Auth__AllowRegistration=false

# ---- Safety: keep TRUE until Gmail is connected and you have tested end to end.
Email__TestMode=true

# ---- Claude (Anthropic) — https://console.anthropic.com
AI__Provider=claude
AI__Claude__ApiKey=
AI__Claude__Model=claude-opus-5-5
AI__Claude__Effort=medium

# ---- Google Places API (New) — Google Cloud console
GooglePlaces__ApiKey=
GooglePlaces__CostPerRequestUsd=0.035
GooglePlaces__ContentRetentionDays=30

# ---- PageSpeed Insights (key optional but recommended for quota)
PageSpeed__ApiKey=

# ---- Gmail OAuth (Google Cloud console → OAuth client "Web application")
GoogleOAuth__ClientId=
GoogleOAuth__ClientSecret=
GoogleOAuth__RedirectUri=https://api.example.com/api/v1/integrations/google/callback
GoogleOAuth__AppReturnUrl=leadpilot://settings/integrations

# ---- Firebase Cloud Messaging (place the service-account JSON at deploy/secrets/firebase.json)
Firebase__ServiceAccountFile=/run/secrets/leadpilot/firebase.json

# ---- WhatsApp Cloud API (leave disabled until opt-in collection is in place)
WhatsApp__Enabled=false
WhatsApp__AccessToken=
WhatsApp__PhoneNumberId=

# ---- Background jobs
Jobs__WorkerCount=4
